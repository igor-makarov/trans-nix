#!/usr/bin/env python3.14
"""Executable bootstrap for trans-nix."""

from __future__ import annotations

import importlib
import sys
from pathlib import Path

# Direct execution puts ``bin`` rather than the repository root on sys.path.
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
commands = importlib.import_module("trans_nix.commands")

if __name__ == "__main__":
    commands.entrypoint()
